---
import { workflow } from '../content/site';
interface Props { housing?: boolean; }
const { housing = false } = Astro.props;
---
<section class="section workflow-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">A simple service loop</p><h2>Drop off. Wash & fold. Pick up.</h2></div><p>{housing ? 'A familiar place for residents. A planned collection route for the laundry provider.' : 'Customers get a convenient handoff. Your team stays in charge of the laundry.'}</p></div><ol class="workflow">{workflow.map((step,i) => <li><div class="step-mark"><span class="step-number">0{i+1}</span>{i === 0 ? <svg class="step-icon" viewBox="0 0 40 40" aria-hidden="true"><path d="M12 15h16v18H12zM16 15v-3a4 4 0 0 1 8 0v3M20 6v6M16.5 9.5 20 13l3.5-3.5" /></svg> : i === 1 ? <svg class="step-icon" viewBox="0 0 40 40" aria-hidden="true"><path d="M9 13h22l-2 20H11L9 13ZM14 8c1.5 2 3 2 4.5 0S22 6 24 8s3.5 2 5 0M14 21c2-2 4-2 6 0s4 2 6 0" /></svg> : <svg class="step-icon" viewBox="0 0 40 40" aria-hidden="true"><path d="M12 11h16v22H12zM16 11V8h8v3M20 28V17M16.5 20.5 20 17l3.5 3.5" /></svg>}</div><h3>{step.title}</h3><p>{step.body}</p></li>)}</ol><p class="fineprint">Proposed workflow. Order acceptance, notifications and access are configured with the selected operator and system.</p></div></section>
