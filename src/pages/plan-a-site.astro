---
import SiteLayout from '../layouts/SiteLayout.astro';
const mode=import.meta.env.PUBLIC_INQUIRY_MODE === 'server' ? 'server' : 'email';
---
<SiteLayout title="Plan a laundry locker site | OurPort" description="Tell us about your laundromat, apartment community or building project. Start a conversation about fit, service and pricing.">
  <div class="container inquiry-layout">
    <section class="inquiry-intro"><p class="eyebrow">Let’s start with your site</p><h1>A few details. <br /> A useful <br /> conversation.</h1><p class="lead">Tell us where you’re planning and what you have today. We’ll work through the service, space and fit together.</p><div class="inquiry-contact"><p>Prefer to get in touch directly?</p><a href="mailto:Mike@Monetize-that.com">Mike@Monetize-that.com</a></div><p class="inquiry-note">You don’t need final dimensions or a chosen locker. A working idea is enough to begin.</p></section>
    <form class="inquiry-form" id="site-inquiry" data-mode={mode} novalidate>
      <div id="form-errors" class="form-errors" role="alert" tabindex="-1" hidden></div>
      <fieldset><legend>What are you planning?</legend><div class="role-options"><label class="role-choice"><input type="radio" name="role" value="laundromat" checked />Laundromat</label><label class="role-choice"><input type="radio" name="role" value="housing" />Apartment or student housing</label><label class="role-choice"><input type="radio" name="role" value="builder" />Builder or developer</label></div></fieldset>
      <fieldset><legend>Your contact & location</legend><div class="form-grid"><label>Your name<input name="contactName" autocomplete="name" required maxlength="120" aria-describedby="error-contactName" /><span class="field-error" id="error-contactName"></span></label><label>Email<input name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="error-email" /><span class="field-error" id="error-email"></span></label><label>Site or project name <small>optional</small><input name="projectName" autocomplete="organization" maxlength="180" /></label><label>City and state<input name="location" autocomplete="address-level2" required maxlength="180" aria-describedby="error-location" /><span class="field-error" id="error-location"></span></label><label>Number of locations <small>optional</small><input name="locationCount" type="number" min="1" max="10000" step="1" inputmode="numeric" aria-describedby="error-locationCount" /><span class="field-error" id="error-locationCount"></span></label><label>Current laundry service <small>optional</small><select name="currentService"><option value="">Not sure yet</option><option>Wash-and-fold in place</option><option>Planning wash-and-fold</option><option>Pickup and delivery</option><option>No laundry service yet</option></select></label></div></fieldset>
      <label>What would you like the site to do? <small>optional</small><textarea name="note" maxlength="2000" placeholder="A new drop-off point, easier pickup, a resident amenity…"></textarea></label>
      <details class="form-details"><summary>Add a little about your setup <span>Optional · you can share this later</span></summary><p>Only share what you know. “Not sure yet” is fine.</p>
        <fieldset data-branch="laundromat"><legend>Your laundry operation</legend><label>Current order or point-of-sale system<input name="dashboard" maxlength="180" placeholder="Platform name, or not sure yet" /></label><div class="form-grid"><label>Staffed processing hours<input name="processingHours" maxlength="180" /></label><label>Customer access hours<input name="accessHours" maxlength="180" /></label></div><label>Full bag & finished-order size<input name="bagSize" maxlength="300" placeholder="If known; include units and loading orientation" /></label></fieldset>
        <fieldset data-branch="housing" hidden disabled><legend>Your community</legend><label>Number of homes or student beds<input name="homesOrBeds" type="number" min="1" max="100000" step="1" aria-describedby="error-homesOrBeds" /><span class="field-error" id="error-homesOrBeds"></span></label><label>Laundry provider<select name="providerStatus"><option value="">Not sure yet</option><option>Already selected</option><option>In discussion</option><option>Looking for a provider</option></select></label><label>Resident app or access system<input name="residentSystem" maxlength="180" /></label></fieldset>
        <fieldset data-branch="builder" hidden disabled><legend>Your building project</legend><label>Project stage<select name="siteStage"><option value="">Not sure yet</option><option>Early planning</option><option>Design development</option><option>Under construction</option><option>Existing-site retrofit</option></select></label><label>Available wall dimensions<input name="wallDimensions" maxlength="200" placeholder="If known; include units" /></label><label>Power, network or access considerations<textarea name="siteConstraints" maxlength="1000"></textarea></label></fieldset>
      </details>
      <div class="hp-field" aria-hidden="true"><label>Company website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
      <button class="button" type="submit" id="review-button">Review your inquiry <span aria-hidden="true">↗</span></button>
      <p class="form-submit-note">{mode==='email' ? 'Review your details, then open an email to Mike. Nothing is sent or stored by this page.' : 'Your details are used to respond to this business inquiry. Please do not include resident information or laundry-order details.'}</p>
      <section id="inquiry-review" class="review-panel" tabindex="-1" hidden><p class="eyebrow">Your site inquiry</p><h2>Ready for a conversation.</h2><dl id="review-values"></dl><div class="review-actions"><a class="button" id="email-inquiry" href="mailto:Mike@Monetize-that.com" hidden>Open inquiry email <span aria-hidden="true">↗</span></a><button class="button" id="send-inquiry" type="button" hidden>Send inquiry <span aria-hidden="true">↗</span></button><button class="button button-outline" id="copy-inquiry" type="button">Copy details</button><button class="button button-outline" id="edit-inquiry" type="button">Edit details</button></div><p id="review-help">Your email app will open a draft addressed to Mike. Review it and send when you’re ready.</p><p id="form-status" class="form-status" role="status"></p></section>
      <noscript><p class="noscript-note">To discuss a site, email <a href="mailto:Mike@Monetize-that.com">Mike@Monetize-that.com</a> with your name, location and project type. This form needs JavaScript to prepare an inquiry.</p></noscript>
    </form>
  </div>
  <script>
    const form=document.querySelector<HTMLFormElement>('#site-inquiry')!;
    const review=document.querySelector<HTMLElement>('#inquiry-review')!;
    const errors=document.querySelector<HTMLElement>('#form-errors')!;
    const status=document.querySelector<HTMLElement>('#form-status')!;
    const names:Record<string,string>={role:'Project type',contactName:'Contact',email:'Email',projectName:'Project',location:'City / state',locationCount:'Locations',currentService:'Current service',note:'Your plans',dashboard:'Order system',processingHours:'Processing hours',accessHours:'Access hours',bagSize:'Bag / return size',homesOrBeds:'Homes / beds',providerStatus:'Laundry provider',residentSystem:'Resident system',siteStage:'Site stage',wallDimensions:'Wall dimensions',siteConstraints:'Site considerations'};
    const roleNames:Record<string,string>={laundromat:'Laundromat',housing:'Apartment / student housing',builder:'Builder / developer'};
    let snapshot:Record<string,string>={}; let emailText=''; let sending=false; let requestId=''; let previousPayload='';
    function updateRole(){const role=(form.elements.namedItem('role') as RadioNodeList).value;form.querySelectorAll<HTMLFieldSetElement>('[data-branch]').forEach(branch=>{branch.hidden=branch.dataset.branch!==role;branch.disabled=branch.hidden;});review.hidden=true;}
    const selected=new URLSearchParams(location.search).get('role');
    if(selected && Object.hasOwn(roleNames,selected)){(form.querySelector(`input[name="role"][value="${selected}"]`) as HTMLInputElement).checked=true;}
    updateRole();
    form.querySelectorAll('input[name="role"]').forEach(r=>r.addEventListener('change',updateRole));
    form.addEventListener('input',()=>{if(!sending)review.hidden=true;});
    function validate(){errors.hidden=true;let messages:string[]=[];form.querySelectorAll<HTMLInputElement>('input').forEach(input=>{if(input.disabled || input.closest('fieldset[disabled]') || input.name==='website')return;const target=document.getElementById('error-'+input.name);let message='';if(input.required && !input.value.trim())message=input.name==='contactName'?'Please enter your name.':input.name==='email'?'Please enter your email.':'Please enter the city and state.';else if(input.value && !input.checkValidity())message=input.type==='email'?'Please enter a valid email address.':'Please enter a whole number within the indicated range.';input.setAttribute('aria-invalid',String(Boolean(message)));if(target)target.textContent=message;if(message)messages.push(message);});if(messages.length){errors.textContent=messages.join(' ');errors.hidden=false;errors.focus();return false;}return true;}
    form.addEventListener('submit',event=>{event.preventDefault();if(!validate())return;snapshot={};for(const [key,value] of new FormData(form)){if(names[key] && typeof value==='string' && value.trim())snapshot[key]=value.trim();}const payload=JSON.stringify(snapshot);if(payload!==previousPayload){requestId=crypto.randomUUID();previousPayload=payload;}const list=document.querySelector('#review-values')!;list.replaceChildren();for(const [key,value] of Object.entries(snapshot)){const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=names[key];dd.textContent=key==='role'?roleNames[value]:value;list.append(dt,dd);}emailText='OurPort site inquiry\n\n'+Object.entries(snapshot).map(([key,value])=>`${names[key]}: ${key==='role'?roleNames[value]:value}`).join('\n');const email=document.querySelector<HTMLAnchorElement>('#email-inquiry')!;const server=form.dataset.mode==='server';email.hidden=server;email.href='mailto:Mike@Monetize-that.com?subject='+encodeURIComponent('OurPort site inquiry — '+(snapshot.projectName||snapshot.location))+'&body='+encodeURIComponent(emailText);document.querySelector<HTMLElement>('#send-inquiry')!.hidden=!server;document.querySelector('#review-help')!.textContent=server?'Check your details before sending.':'Your email app will open a draft addressed to Mike. Review it and send when you’re ready. If the draft does not open, copy these details into an email to Mike@Monetize-that.com.';review.hidden=false;status.textContent='';review.focus();});
    document.querySelector('#edit-inquiry')!.addEventListener('click',()=>{review.hidden=true;(form.elements.namedItem('contactName') as HTMLInputElement).focus();});
    document.querySelector('#copy-inquiry')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(emailText);status.textContent='Details copied. Paste them into your email to Mike@Monetize-that.com.';}catch{status.textContent='Copy is unavailable in this browser. Select the details above and copy them manually.';}});
    document.querySelector('#send-inquiry')!.addEventListener('click',async()=>{if(sending)return;sending=true;const button=document.querySelector<HTMLButtonElement>('#send-inquiry')!;button.disabled=true;status.textContent='Sending your inquiry…';try{const response=await fetch('/api/site-inquiry',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...snapshot,requestId,website:(form.elements.namedItem('website') as HTMLInputElement).value,sourcePath:location.pathname}),signal:AbortSignal.timeout(15000)});if(!response.ok)throw new Error('Not saved');const receipt=await response.json();if(receipt.ok!==true)throw new Error('Receipt not confirmed');status.textContent='Thanks. We’ll review the site and follow up about fit and pricing.';button.hidden=true;document.querySelector('#review-help')!.textContent='Your inquiry has been received.';}catch{status.textContent='We couldn’t confirm receipt. Your details are still here. Retry, or open an email to Mike.';document.querySelector<HTMLElement>('#email-inquiry')!.hidden=false;}finally{sending=false;button.disabled=false;}});
  </script>
</SiteLayout>
