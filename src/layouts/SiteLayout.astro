---
import '../styles/global.css';
import { brand, navigation } from '../content/site';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#012347" />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="OurPort home">
          <span class="brand-art brand-logo"><img src="/images/ourport-logo-reverse.jpg" width="1200" height="800" alt="OurPort — Your services arrive here. Powered by Monetize That." decoding="async" /></span>
        </a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="main-navigation" type="button">Menu <span aria-hidden="true">＋</span></button>
        <nav id="main-navigation" aria-label="Main navigation">
          {navigation.map(item => <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>)}
          <details class="nav-options"><summary>Site options <span aria-hidden="true">＋</span></summary><div><a href="/cctv/" aria-current={path === '/cctv/' ? 'page' : undefined}>CCTV monitoring</a><a href="/wifi-wap/" aria-current={path === '/wifi-wap/' ? 'page' : undefined}>WiFi & WAP</a></div></details>
          <a class="button button-small" href="/plan-a-site/" aria-current={path === '/plan-a-site/' ? 'page' : undefined}>Plan a site <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-main">
        <div><a class="footer-wordmark" href="/">OUR<span>PORT</span></a><p>{brand.tagline}</p><small>Powered by Monetize That</small></div>
        <div><p class="footer-label">Explore</p><a href="/laundromats/">For laundromats</a><a href="/housing/">For apartments & student housing</a><a href="/cctv/">CCTV monitoring options</a><a href="/wifi-wap/">WiFi & WAP options</a><a href="/plan-a-site/?role=builder">For builders & developers</a></div>
        <div><p class="footer-label">Let’s talk laundry.</p><a class="contact-link" href={`mailto:${brand.email}`}>{brand.email}</a><a href="/plan-a-site/">Discuss fit and pricing <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} OurPort</span><span>Concept imagery. Configuration and service availability vary by site.</span></div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#main-navigation');
      const header = document.querySelector<HTMLElement>('.site-header');
      const options = document.querySelector<HTMLDetailsElement>('.nav-options');
      const optionsToggle = options?.querySelector<HTMLElement>('summary');
      const mobile = window.matchMedia('(max-width: 800px)');
      const close = () => {
        toggle?.setAttribute('aria-expanded', 'false');
        nav?.classList.remove('is-open');
        if (options) options.open = false;
      };
      toggle?.addEventListener('click', () => {
        if (toggle.getAttribute('aria-expanded') === 'true') close();
        else {
          toggle.setAttribute('aria-expanded', 'true');
          nav?.classList.add('is-open');
        }
      });
      document.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        if (options?.open) {
          options.open = false;
          optionsToggle?.focus();
        } else if (toggle?.getAttribute('aria-expanded') === 'true') {
          close();
          toggle.focus();
        }
      });
      document.addEventListener('click', event => {
        if (!(event.target instanceof Node)) return;
        if (!header?.contains(event.target)) close();
        else if (options && !options.contains(event.target)) options.open = false;
      });
      document.addEventListener('focusin', event => {
        if (!(event.target instanceof Node)) return;
        if (options && !options.contains(event.target)) options.open = false;
        if (mobile.matches && !header?.contains(event.target)) close();
      });
      mobile.addEventListener('change', () => {
        const focusWasInNav = nav?.contains(document.activeElement);
        close();
        if (mobile.matches && focusWasInNav) toggle?.focus();
      });
      nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', close));
    </script>
  </body>
</html>
